# AI Embeddings
DASHSCOPE_API_KEY=sk-ws-H.REIXLIP.Jewn.MEYCIQCBmAns3M0wphhfzVUYiD7nBtvk4HUXIUxikQkNWDpzyAIhAOI60KKDAB7sHhtfpQGh6Sdis-Mkk4FugNML0tWAzU32
# Embedding模型选择: "dashscope" 使用云端API(慢,~42s), "local" 使用本地中文模型(快,~1-2s)
EMBEDDING_MODEL=local
# 本地Embedding模型
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# Milvus Configuration
MILVUS_HOST=192.168.100.129
MILVUS_PORT=19530
MILVUS_URI=http://192.168.100.129:19530
MILVUS_TOKEN=
MILVUS_METRIC_TYPE=L2

# Memory System Configuration (三层记忆系统)
MEMORY_COLLECTION=long_term_memory
MEMORY_EMBEDDING_DIM=1536
MEMORY_EXTRACTION_TOKEN_THRESHOLD=2000
MEMORY_EXTRACTION_INTERVAL_SEC=300

# Redis Configuration
REDIS_HOST=192.168.100.129
REDIS_PORT=6379
REDIS_PASSWORD=123456

# Optional: Milvus Authentication (if enabled)
# MILVUS_USER=username
# MILVUS_PASSWORD=password

# Vector Store Selection (true for Milvus, false for FAISS)
USE_MILVUS=true
# Vector Store Configuration
VECTOR_STORE_PERSIST_DIR=./faiss_index
VECTOR_STORE_COLLECTION_NAME=ai_knowledge_collection

# Rerank Configuration
# Rerank type: 'bge' (recommended, local), 'cohere' (requires API key), 'simple' (fallback), 'none' (disabled)
RERANKER_TYPE=bge

# Optional: Cohere API Key (if using Cohere reranker)
# COHERE_API_KEY=your_cohere_api_key

# Text Chunking Configuration
# Chunk strategy: 'semantic' (recommended), 'recursive' (default)
CHUNK_STRATEGY=semantic
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=100

# Tesseract OCR Configuration
# Tesseract executable path
TESSERACT_PATH=/opt/homebrew/bin/tesseract

# Temporary Files Configuration
TEMP_DIR=./temp

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8080

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MySQL
MYSQL_HOST=192.168.100.129
MYSQL_PORT=3306
MYSQL_DATABASE=ai_knowledge_db
MYSQL_USERNAME=root
MYSQL_PASSWORD=Wqj.120224