# AI Embeddings
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY

# Milvus Configuration
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Optional: Milvus Authentication (if enabled)
# MILVUS_USER=username
# MILVUS_PASSWORD=password

# Vector Store Configuration (Milvus)
VECTOR_STORE_COLLECTION_NAME=ai_knowledge_collection

# Rerank Configuration
# Rerank type: 'bge' (recommended, local), 'cohere' (requires API key), 'simple' (fallback), 'none' (disabled)
# bge 效果最好但首次需下载 ~1.1GB 模型，开发环境建议用 simple
RERANKER_TYPE=simple

# Optional: Cohere API Key (if using Cohere reranker)
# COHERE_API_KEY=your_cohere_api_key

# Text Chunking Configuration
# Chunk strategy: 'semantic' (embedding-based), 'structural' (paragraph/sentence/punctuation), 'recursive'
CHUNK_STRATEGY=semantic
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=100

# Semantic Chunking Tuning (only used when CHUNK_STRATEGY=semantic)
# Breakpoint type: 'percentile', 'standard_deviation', 'interquartile', 'gradient'
# SEMANTIC_BREAKPOINT_TYPE=percentile
# Breakpoint amount (None = auto/default 95th percentile)
# SEMANTIC_BREAKPOINT_AMOUNT=
# Buffer size (number of sentences combined for embeddings)
# SEMANTIC_BUFFER_SIZE=1

# Tesseract OCR Configuration
# Tesseract executable path（留空则自动检测常见安装路径）
TESSERACT_PATH=

# Temporary Files Configuration
TEMP_DIR=./temp

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8080

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
